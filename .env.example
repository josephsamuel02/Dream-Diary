# ─────────────────────────────────────────────────────────────
# Supabase – Dream Diary  (example / template)
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# Find them in: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# AdMob banner placement for the diary list/home area.
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-your-publisher-id/your-banner-unit-id

# AdMob interstitial ad for app idle / dormant reactivation.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-your-publisher-id/your-interstitial-unit-id
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IDLE_SECONDS=120
EXPO_PUBLIC_ADMOB_INTERSTITIAL_COOLDOWN_MINUTES=30
EXPO_PUBLIC_ADMOB_INTERSTITIAL_SHOW_PROBABILITY=0.25

# AdMob rewarded ads for premium theme/background unlock flow.
EXPO_PUBLIC_ADMOB_REWARDED_THEME_ID=ca-app-pub-your-publisher-id/your-rewarded-theme-unit-id
EXPO_PUBLIC_ADMOB_REWARDED_BACKGROUND_ID=ca-app-pub-your-publisher-id/your-rewarded-background-unit-id

# Limit banner exposure to a few impressions per day to avoid annoyance.
EXPO_PUBLIC_ADMOB_BANNER_MAX_PER_DAY=3

# AdMob application IDs used by the native build. Leave unset if you want Google's test IDs instead.
ADMOB_ANDROID_APP_ID=ca-app-pub-your-publisher-id~your-android-app-id
ADMOB_IOS_APP_ID=ca-app-pub-your-publisher-id~your-ios-app-id
